{
  "version": "3.1",
  "nombreApp": "Zip",
  "idApp": "com.zip.app",
  "descApp": "Zip convertidor",
  "colorApp": "#000000",
  "codigoHTML": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>MAUSKI V6.1 FIX CARPETAS</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{font-family:monospace;background:#0d1117;color:#e6edf3;padding:14px;max-width:700px;margin:auto}\nh1{text-align:center;color:#ff0040;margin:10px 0}\n.card{background:#161b22;border:1px solid #30363d;padding:12px;margin:10px 0;border-radius:10px}\ninput,textarea{width:100%;padding:12px;background:#0d1117;border:1px solid #30363d;color:#fff;border-radius:8px;margin-top:6px}\n.drop{border:2px dashed #ff0040;padding:28px;text-align:center;border-radius:12px;cursor:pointer}\n.drop.ok{border-color:#00ff88;background:rgba(0,255,136,.07)}\nbutton{width:100%;padding:16px;background:#238636;color:#fff;border:none;border-radius:10px;font-weight:900;font-size:16px;cursor:pointer}\nbutton:disabled{background:#30363d}\n#log{background:#000;padding:10px;font-size:11px;color:#00ff88;max-height:250px;overflow:auto;white-space:pre-wrap;border-radius:8px;margin-top:10px}\n.badge{font-size:10px;background:#21262d;padding:3px 6px;border-radius:4px;margin:2px;display:inline-block}\n</style>\n</head>\n<body>\n<h1>⚡ MAUSKI V6.1 FIX ⚡</h1>\n<div class=\"card\">\n<label>TOKEN GITHUB</label><input id=\"token\" type=\"password\" placeholder=\"ghp_...\">\n<label style=\"margin-top:8px;display:block\">NOMBRE REPO</label><input id=\"repo\" placeholder=\"mi-proyecto\">\n</div>\n<div class=\"card\">\n<button id=\"btnFolder\" style=\"background:#1f6feb;margin-bottom:8px\">📁 SELECCIONAR CARPETA COMPLETA</button>\n<button id=\"btnFiles\" style=\"background:#21262d;border:1px solid #30363d\">📄 ARCHIVOS SUELTOS</button>\n</div>\n<div class=\"drop\" id=\"zona\">\n<div id=\"zonaTxt\">📁 ARRASTRA TU CARPETA AQUI</div>\n<div id=\"lista\" style=\"margin-top:10px\"></div>\n</div>\n<input type=\"file\" id=\"fileInput\" multiple style=\"display:none\">\n<input type=\"file\" id=\"fileFolder\" webkitdirectory style=\"display:none\">\n<div class=\"card\"><label>O PEGA HTML</label><textarea id=\"code\" rows=\"5\" placeholder=\"<html>...</html>\"></textarea></div>\n<button id=\"btnSubir\">🚀 SUBIR TODO</button>\n<div id=\"log\">Listo...</div>\n<div id=\"result\"></div>\n\n<script>\nconst $=id=>document.getElementById(id);\nlet archivos=[];\nconst log=m=>{$('log').innerText+='\\n'+m; $('log').scrollTop=99999;}\nconst toBase64=f=>new Promise((res,rej)=>{let r=new FileReader();r.onload=()=>res(r.result.split(',')[1]);r.onerror=rej;r.readAsDataURL(f);});\n\nfunction render(){\n if(!archivos.length){$('zonaTxt').innerHTML='📁 ARRASTRA TU CARPETA AQUI';$('lista').innerHTML='';$('zona').classList.remove('ok');return;}\n $('zona').classList.add('ok');\n $('zonaTxt').innerText=`✅ ${archivos.length} archivos listos`;\n $('lista').innerHTML=archivos.map(f=>`<span class=badge>${f.path}</span>`).join(' ');\n}\n\nfunction limpiarPath(p, isFolder){\n // Si es webkitdirectory: mi-sitio/index.html -> index.html , mi-sitio/css/style.css -> css/style.css\n if(isFolder && p.includes('/')) return p.split('/').slice(1).join('/') || 'index.html';\n return p;\n}\n\nfunction procesarLista(fileList){\n const isFolder = fileList[0] && fileList[0].webkitRelativePath;\n archivos = Array.from(fileList).map(f=>{\n   let raw = f.webkitRelativePath || f.name;\n   let path = limpiarPath(raw, !!isFolder);\n   return {file:f, path:path.replace(/\\\\/g,'/')};\n }).filter(a=>a.path && !a.path.startsWith('.'));\n render();\n log(`Cargados ${archivos.length} archivos`);\n}\n\n$('btnFolder').onclick=()=>$('fileFolder').click();\n$('btnFiles').onclick=()=>$('fileInput').click();\n$('fileInput').onchange=e=>procesarLista(e.target.files);\n$('fileFolder').onchange=e=>procesarLista(e.target.files);\n\nconst zona=$('zona');\nzona.onclick=()=>$('fileFolder').click();\nzona.ondragover=e=>{e.preventDefault(); zona.style.borderColor='#00ff88';};\nzona.ondragleave=()=>zona.style.borderColor='#ff0040';\nzona.ondrop=async e=>{\n e.preventDefault(); zona.style.borderColor='#ff0040';\n // Usa files normal si no es carpeta compleja\n procesarLista(e.dataTransfer.files);\n};\n\n$('btnSubir').onclick=async()=>{\n let token=$('token').value.trim();\n let repo=$('repo').value.trim().toLowerCase().replace(/[^a-z0-9-_]/g,'-');\n let code=$('code').value.trim();\n let btn=$('btnSubir');\n if(!token || token.length<20){alert('Token malo may');return;}\n if(!repo){alert('Pon nombre repo');return;}\n if(archivos.length==0 && !code){alert('Selecciona carpeta o pega html');return;}\n btn.disabled=true; $('log').innerText='';\n try{\n  log('→ Verificando token...');\n  let uR=await fetch('https://api.github.com/user',{headers:{Authorization:'token '+token}});\n  let uJ=await uR.json(); if(!uR.ok) throw new Error(uJ.message);\n  let user=uJ.login; log('✓ '+user);\n\n  log('→ Creando repo '+repo);\n  let cr=await fetch('https://api.github.com/user/repos',{method:'POST',headers:{Authorization:'token '+token,'Content-Type':'application/json'},body:JSON.stringify({name:repo,auto_init:true,private:false})});\n  if(cr.status!==201 && cr.status!==422){throw new Error(await cr.text());}\n  if(cr.status===422) log('! Repo ya existía, usando ese');\n  await new Promise(r=>setTimeout(r,2500));\n\n  async function subir(path,b64){\n   // FIX IMPORTANTE: encodeURI para carpetas con espacios\n   let urlPath = path.split('/').map(encodeURIComponent).join('/');\n   let sha=null;\n   try{\n     let c=await fetch(`https://api.github.com/repos/${user}/${repo}/contents/${urlPath}`,{headers:{Authorization:'token '+token}});\n     if(c.ok){let j=await c.json(); sha=j.sha;}\n   }catch{}\n   let body={message:'Mauski V6.1: '+path,content:b64,branch:'main'};\n   if(sha) body.sha=sha;\n   let r=await fetch(`https://api.github.com/repos/${user}/${repo}/contents/${urlPath}`,{method:'PUT',headers:{Authorization:'token '+token,'Content-Type':'application/json'},body:JSON.stringify(body)});\n   if(!r.ok) throw new Error('Error '+path+': '+(await r.text()).slice(0,200));\n  }\n\n  if(archivos.length>0){\n   log(`→ Subiendo ${archivos.length} archivos...`);\n   for(let i=0;i<archivos.length;i++){\n     let b64=await toBase64(archivos[i].file);\n     await subir(archivos[i].path, b64);\n     log(` + ${archivos[i].path} (${i+1}/${archivos.length})`);\n   }\n  }else{\n   log('→ Subiendo index.html pegado...');\n   let b64=btoa(unescape(encodeURIComponent(code)));\n   await subir('index.html', b64);\n  }\n\n  log('→ Activando Pages...');\n  try{\n    await fetch(`https://api.github.com/repos/${user}/${repo}/pages`,{method:'POST',headers:{Authorization:'token '+token,'Content-Type':'application/json'},body:JSON.stringify({source:{branch:'main',path:'/'}})});\n  }catch{}\n  \n  let url=`https://${user}.github.io/${repo}/`;\n  $('result').innerHTML=`<div class=card style=border-color:#00ff88><b style=color:#00ff88>✅ LISTO:</b><br><a href=\"${url}\" target=_blank style=color:#58a6ff;word-break:break-all>${url}</a><br><br><button onclick=\"navigator.clipboard.writeText('${url}');alert('Copiado')\" style=\"background:#000;margin-top:10px\">📋 COPIAR LINK</button><br><br><small>Espera 1-2 min y recarga, Github tarda.</small></div>`;\n  log('✓ URL: '+url);\n  $('token').value='';\n }catch(e){log('❌ '+e.message); alert(e.message);}\n finally{btn.disabled=false;}\n};\n</script>\n</body>\n</html>",
  "logoBase64": "data:image/png;base64,",
  "timestamp": "2026-07-27T10:13:04.807Z"
}